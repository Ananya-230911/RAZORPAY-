# Copy this file to .env and fill in your real key.
# Never commit the real .env file.

# Free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Model used by the Investigation Agent (agents/investigator.py).
# Defaults to openai/gpt-oss-120b in code if this is unset.
# Groq's model lineup changes over time -- if this one errors out, try
# openai/gpt-oss-20b or llama-3.1-8b-instant instead.
GROQ_MODEL=openai/gpt-oss-120b
