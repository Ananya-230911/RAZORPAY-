# Copy this file to .env and fill in your real key.
# Never commit the real .env file.

# Free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Model used by the Investigation Agent (agents/investigator.py).
# Defaults to llama-3.3-70b-versatile in code if this is unset.
GROQ_MODEL=llama-3.3-70b-versatile
