# Copy this file to .env and fill in your real key.
# Never commit the real .env file.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used by the Investigation Agent (agents/investigator.py).
# Defaults to claude-opus-5 in code if this is unset. Swap to a cheaper
# model (e.g. claude-sonnet-5 or claude-haiku-4-5) for high-volume runs --
# the exception queue is usually small enough that this rarely matters.
ANTHROPIC_MODEL=claude-opus-5
